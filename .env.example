# RelayDock daemon
RELAYDOCK_HOST=127.0.0.1
RELAYDOCK_PORT=4173
RELAYDOCK_DATA_DIR=.relaydock
# Optional stable token for Studio API and /v1 Gateway Bearer auth
RELAYDOCK_TOKEN=

# Optional Provider credential fallback. Keys entered in Studio are encrypted
# at rest with AES-256-GCM instead of being stored as plaintext.
DEEPSEEK_API_KEY=

# Optional Base64-encoded 32-byte master key. When omitted, RelayDock creates
# RELAYDOCK_DATA_DIR/credentials.key. Back up either source: saved API keys
# cannot be recovered if the master key is lost.
RELAYDOCK_MASTER_KEY=
