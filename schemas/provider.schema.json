{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaydock.local/schemas/provider.schema.json",
  "title": "RelayDock Provider",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "baseUrl",
    "model",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "enum": [
        "openai-compatible"
      ]
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "apiKeyEnv": {
      "type": [
        "string",
        "null"
      ]
    },
    "contextWindow": {
      "type": "integer",
      "minimum": 1024
    },
    "maxOutputTokens": {
      "type": "integer",
      "minimum": 128
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
